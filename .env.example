# Database Configuration
DATABASE_URL=mysql://root:password@localhost:3306/attendai

# Authentication & Session
JWT_SECRET=your-super-secret-jwt-key
COOKIE_NAME=attendai_session

# Client Analytics & App Configuration
VITE_APP_ID=attendai
VITE_ANALYTICS_ENDPOINT=https://analytics.example.com
VITE_ANALYTICS_WEBSITE_ID=attendai-analytics-id

# OAuth Configuration (if applicable)
OAUTH_SERVER_URL=https://auth.example.com
APP_ID=your-app-id
APP_SECRET=your-app-secret

# LLM / AI Integrations
# Required: API key for your LLM provider (Groq, OpenAI-compatible, etc.)
OPENAI_API_KEY=your-llm-api-key
# Required: Base URL for the OpenAI-compatible chat endpoint (e.g. https://api.groq.com/openai/v1)
LLM_API_URL=https://api.groq.com/openai/v1
# Optional: Override the model used by the AI Copilot and anomaly explainer (default: openai/gpt-oss-120b)
LLM_MODEL=openai/gpt-oss-120b

# Email Notifications (Resend)
RESEND_API_KEY=re_123456789
EMAIL_FROM=notifications@attendai.com

# Cron Job Authentication
CRON_SECRET=your-cron-job-secret

# Admin Seeding (Optional)
OWNER_OPEN_ID=admin-openid-value

# Office Geofencing (KLH Bachupally Campus)
VITE_OFFICE_LAT=17.5388
VITE_OFFICE_LNG=78.3861
VITE_OFFICE_RADIUS_M=350
